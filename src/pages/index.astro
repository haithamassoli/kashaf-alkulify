---
import PlatformContent from "../components/PlatformContent.astro";
import Search from "../islands/search";
import Base from "../layouts/Base.astro";
import { SEARCH_ENDPOINT } from "../lib/search-api";
import { person, SHEIKH, SITE, SITE_URL } from "../lib/seo";

const schema = {
  "@context": "https://schema.org",
  "@id": `${SITE_URL}/#website`,
  "@type": "WebSite",
  about: person,
  inLanguage: "ar",
  name: SITE,
  url: `${SITE_URL}/`,
};
---

<Base description={`ابحث في نصوص دروس ${SHEIKH} ومقالاته.`} schema={[schema]}>
  <section class="pt-10 sm:pt-16">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{SITE}</h1>
    <p class="mt-3 text-muted">ابحث في دروس {SHEIKH}</p>
  </section>

  <Search endpoint={SEARCH_ENDPOINT} client:load />

  <PlatformContent />
</Base>
