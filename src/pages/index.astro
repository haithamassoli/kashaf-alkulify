---
import Base from "../layouts/Base.astro";
import { person, SHEIKH, SITE, SITE_URL } from "../lib/seo";

const schema = {
  "@context": "https://schema.org",
  "@id": `${SITE_URL}/#website`,
  "@type": "WebSite",
  about: person,
  inLanguage: "ar",
  name: SITE,
  url: `${SITE_URL}/`,
};
---

<Base description={`كتب ومصنفات ${SHEIKH} للقراءة والتنزيل.`} schema={[schema]}>
  <h1 class="mt-10 text-2xl font-semibold tracking-tight sm:text-3xl">
    {SITE}
  </h1>
  <p class="mt-3 text-muted leading-8">
    كشّاف غير رسمي يجمع كتب ومصنفات {SHEIKH} في مكان واحد، مرتّبةً ومتاحةً للقراءة
    والتنزيل بصيغة PDF.
  </p>

  <a
    class="mt-6 inline-flex min-h-11 items-center rounded-lg bg-accent px-5 font-medium text-accent-fg transition-opacity hover:opacity-90"
    href="/b/"
  >
    تصفَّح الكتب
  </a>
  <a
    class="ms-4 mt-6 inline-flex min-h-11 items-center text-accent underline"
    href="/search/"
    >البحث في الدروس والمقالات</a
  >
</Base>
