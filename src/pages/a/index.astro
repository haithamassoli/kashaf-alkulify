---
import { Articles } from "../../islands/articles";
import Base from "../../layouts/Base.astro";
import { breadcrumb, SHEIKH, SITE_URL } from "../../lib/seo";

const schema = {
  "@context": "https://schema.org",
  "@id": `${SITE_URL}/a/#collection`,
  "@type": "CollectionPage",
  inLanguage: "ar",
  name: "المقالات",
};
---

<Base
  description={`مقالات ${SHEIKH}.`}
  schema={[schema, breadcrumb([["المقالات", "/a/"]])]}
  title="المقالات"
>
  <Articles client:only="react">
    <div class="pt-8" data-vt-fallback hidden slot="fallback">
      <a
        class="inline-flex min-h-11 items-center text-muted underline underline-offset-4 hover:text-fg"
        href="/a/"
        >المقالات</a
      >
      <span
        class="mt-3 block w-fit rounded-full bg-surface-2 px-3 py-1 text-xs text-muted"
        >مقالة</span
      >
      <h1
        class="mt-4 text-xl font-semibold leading-relaxed sm:text-2xl"
        data-vt-title
      >
        مقالة
      </h1>
    </div>
  </Articles>
</Base>
