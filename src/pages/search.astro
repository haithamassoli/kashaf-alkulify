---
import Search from "../islands/search";
import Base from "../layouts/Base.astro";

const endpoint =
  import.meta.env.PUBLIC_SEARCH_API_URL ??
  (import.meta.env.DEV ? "http://127.0.0.1:8787" : "");
---

<Base
  description="ابحث في نصوص الدروس والمقالات، واقرأ النص الأصلي وسياقه."
  title="البحث"
>
  <section class="pt-10 sm:pt-16">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
      البحث في الدروس والمقالات
    </h1>
    <p class="mt-3 text-muted">اكتب عبارة سمعتها أو موضوعًا تريد العثور عليه</p>
  </section>
  <Search endpoint={endpoint.replace(/\/$/, "")} client:load />
</Base>
