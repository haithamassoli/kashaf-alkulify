---
import Search from "../islands/search";
import Base from "../layouts/Base.astro";

const endpoint =
  import.meta.env.PUBLIC_SEARCH_API_URL ??
  (import.meta.env.DEV ? "http://127.0.0.1:8787" : "");
---

<Base
  description="ابحث في نصوص الدروس والمقالات، واقرأ النص الأصلي وسياقه."
  title="البحث"
>
  <h1 class="mt-10 text-2xl font-semibold">البحث في الدروس والمقالات</h1>
  <p class="mt-3 text-muted leading-8">
    اختر نوع المحتوى، ثم اكتب عبارتك أو موضوعك. النتائج نصوص من المصادر؛ اقرأ
    السياق واستمع إلى الكلام كاملًا لفهم المقصود.
  </p>
  <Search endpoint={endpoint.replace(/\/$/, "")} client:load />
</Base>
