---
import { Playlists } from "../../islands/playlists";
import Base from "../../layouts/Base.astro";
import { breadcrumb, SHEIKH, SITE_URL } from "../../lib/seo";

const schema = {
  "@context": "https://schema.org",
  "@id": `${SITE_URL}/p/#collection`,
  "@type": "CollectionPage",
  inLanguage: "ar",
  name: "القوائم",
};
---

<Base
  description={`قوائم وسلاسل دروس ${SHEIKH}.`}
  schema={[schema, breadcrumb([["القوائم", "/p/"]])]}
  title="القوائم"
>
  <Playlists client:only="react">
    <div data-vt-fallback hidden slot="fallback">
      <a
        class="mt-8 inline-flex min-h-11 items-center text-muted underline underline-offset-4 hover:text-fg"
        href="/p/"
        >القوائم</a
      >
      <h1
        class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl"
        data-vt-title
      >
        القوائم
      </h1>
    </div>
  </Playlists>
</Base>
