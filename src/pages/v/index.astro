---
import "@vidstack/react/player/styles/default/theme.css";
import "@vidstack/react/player/styles/default/layouts/audio.css";
import Lesson from "../../islands/lesson";
import Base from "../../layouts/Base.astro";

const endpoint =
  import.meta.env.PUBLIC_SEARCH_API_URL ??
  (import.meta.env.DEV ? "http://127.0.0.1:8787" : "");
---

<Base
  description="استمع إلى الدرس واقرأ تفريغه المتزامن."
  noindex
  title="نتيجة البحث"
  wide
>
  <Lesson endpoint={endpoint.replace(/\/$/, "")} client:only="react">
    <div class="pt-8" data-vt-fallback hidden slot="fallback">
      <a
        class="inline-flex min-h-11 items-center text-sm text-muted hover:text-fg"
        href="/"
        >العودة إلى نتائج البحث</a
      >
      <p
        class="mt-3 inline-flex rounded-full bg-accent-soft px-3 py-1 text-sm text-accent"
        data-vt-query
        hidden
      >
        نتيجة البحث عن:&nbsp;
      </p>
      <h1
        class="mt-3 text-2xl font-semibold leading-relaxed tracking-tight"
        data-vt-title
      >
        درس
      </h1>
    </div>
  </Lesson>
</Base>
