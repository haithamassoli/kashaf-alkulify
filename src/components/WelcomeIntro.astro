---
import { SITE } from "../lib/seo";
import bootstrap from "../lib/welcome-intro.js?raw";
---

<dialog aria-labelledby="welcome-title" id="welcome-intro">
  <div aria-hidden="true" class="intro-frame"></div>
  <span aria-hidden="true" class="intro-top">بين يدي العلم</span>
  <div class="intro-center">
    <div aria-hidden="true" class="intro-emblem">
      <svg class="intro-orbit" fill="none" viewBox="0 0 280 280">
        <title>زخرفة دائرية</title>
        <circle cx="140" cy="140" pathLength="1" r="137"></circle>
        <circle cx="140" cy="140" pathLength="1" r="131"></circle>
      </svg>
      <img alt="" height="240" src="/icon-512.png" width="240">
      <div class="intro-shine"></div>
    </div>
    <span aria-hidden="true" class="intro-rule"></span>
    <h2 id="welcome-title">{SITE}</h2>
    <p>من السؤال إلى موضع الجواب</p>
  </div>
  <button type="button">تخطّي المقدمة</button>
  <div aria-hidden="true" class="intro-progress"></div>
</dialog>

<script is:inline set:html={bootstrap}></script>

<style>
  #welcome-intro {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    color: #f7c45e;
    background: radial-gradient(
      ellipse at 50% 42%,
      #104f58 0%,
      #063440 42%,
      #021e29 100%
    );
    border: 0;
  }

  #welcome-intro[open] {
    display: grid;
    place-items: center;
    animation: intro-exit 550ms 2650ms cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  #welcome-intro::backdrop {
    background: transparent;
  }

  .intro-frame {
    position: absolute;
    inset: 24px;
    pointer-events: none;
    border: 1px solid #f7c45e20;
  }

  .intro-frame::before,
  .intro-frame::after {
    position: absolute;
    inset: -1px;
    margin-inline: 28%;
    content: "";
    border: solid #f7c45e88;
    border-width: 1px 0;
    transform: scaleX(0.2);
    animation: intro-frame 1600ms ease-out forwards;
  }

  .intro-frame::after {
    margin: 24% 0;
    border-width: 0 1px;
    transform: scaleY(0.2);
  }

  .intro-top {
    position: absolute;
    top: max(54px, env(safe-area-inset-top));
    font-size: 12px;
    color: #e2cfaa;
    animation: intro-copy 850ms 200ms both;
  }

  .intro-center {
    padding: 80px 24px;
    text-align: center;
  }

  .intro-emblem {
    position: relative;
    width: clamp(220px, 34vmin, 330px);
    aspect-ratio: 1;
    margin: 0 auto;
    animation: intro-emblem 2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .intro-emblem::before {
    position: absolute;
    inset: -25%;
    content: "";
    background: radial-gradient(circle, #f7c45e14, transparent 68%);
    border-radius: 50%;
    animation: intro-glow 2400ms ease-in-out both;
  }

  .intro-emblem img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 50%;
  }

  .intro-orbit {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
  }

  .intro-orbit circle {
    stroke: #f7c45e66;
    stroke-width: 0.8;
    stroke-dasharray: 1;
    transform: rotate(-90deg);
    transform-origin: center;
    animation: intro-draw 1400ms 100ms cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  .intro-orbit circle + circle {
    stroke: #f7c45e26;
    transform: rotate(90deg);
    animation-delay: 250ms;
  }

  .intro-shine {
    position: absolute;
    inset: 6%;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 35%,
      #fff0b845 49%,
      transparent 63%
    );
    background-size: 300% 100%;
    border-radius: 50%;
    mix-blend-mode: screen;
    animation: intro-shine 1100ms 1200ms both;
  }

  .intro-rule {
    display: block;
    width: 44px;
    height: 1px;
    margin: 26px auto 20px;
    background: linear-gradient(90deg, transparent, #f7c45e, transparent);
  }

  h2 {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 500;
    color: #fff2d4;
    animation: intro-copy 900ms 900ms both;
  }

  p {
    margin-top: 10px;
    font-size: 14px;
    color: #c0cec8;
    animation: intro-copy 900ms 1050ms both;
  }

  button {
    position: absolute;
    bottom: max(28px, env(safe-area-inset-bottom));
    min-height: 44px;
    padding: 0 14px;
    font: inherit;
    color: #f1dbad;
    cursor: pointer;
    background: transparent;
    border: 1px solid #f7c45e38;
    border-radius: 999px;
    animation: intro-copy 850ms 1200ms both;
  }

  button:hover {
    background: #f7c45e15;
  }

  button:focus-visible {
    outline: 2px solid #f7c45e;
    outline-offset: 4px;
  }

  .intro-progress {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, #f7c45e20, #f7c45e);
    transform-origin: right;
    animation: intro-progress 2650ms linear both;
  }

  @keyframes intro-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes intro-frame {
    to {
      transform: scale(1);
    }
  }

  @keyframes intro-emblem {
    from {
      transform: scale(0.88);
    }
  }

  @keyframes intro-copy {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes intro-shine {
    from {
      background-position: 100% 0;
      opacity: 0;
    }
    20%,
    75% {
      opacity: 1;
    }
    to {
      background-position: 0 0;
      opacity: 0;
    }
  }

  @keyframes intro-glow {
    0%,
    100% {
      opacity: 0;
    }
    55% {
      opacity: 1;
    }
  }

  @keyframes intro-progress {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes intro-exit {
    to {
      opacity: 0;
      transform: scale(1.035);
    }
  }

  @media (max-width: 480px) {
    .intro-frame {
      inset: 14px;
    }
  }

  @media (max-height: 560px) {
    .intro-top {
      top: 30px;
    }
    .intro-emblem {
      width: 150px;
    }
    .intro-rule {
      margin: 12px auto;
    }
  }

  @media print, (prefers-reduced-motion: reduce) {
    #welcome-intro[open] {
      display: none;
    }
  }
</style>
