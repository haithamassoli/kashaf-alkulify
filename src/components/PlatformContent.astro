---
import { arabicDate } from "../lib/format";
import { cumulative, series } from "../lib/platform-stats";

const num = (value: number) => value.toLocaleString("en-US");

const cards = [
  {
    icon: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18", "m10.3 8.5 5.2 3.5-5.2 3.5Z"],
    label: "الدروس",
    value: num(4360),
  },
  {
    icon: ["M4 7h12M4 12h12M4 17h7", "m17 13 4 2.5-4 2.5Z"],
    label: "السلاسل",
    value: num(292),
  },
  {
    icon: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18", "M12 7.5V12l3 2"],
    label: "الساعات المفرَّغة",
    value: num(2300),
  },
  {
    date: true,
    icon: [
      "M20 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2Z",
      "M8 9h8M8 13h5",
    ],
    label: "مقاطع التفريغ",
    value: num(379_112),
  },
  {
    icon: [
      "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z",
      "M14 3v5h5",
      "M9 13h6M9 17h4",
    ],
    label: "المقالات",
    value: num(4455),
  },
  {
    icon: [
      "M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z",
      "M8 3v4M16 3v4M4 11h16",
    ],
    label: "آخر إضافة",
    value: arabicDate("2026-09-10"),
  },
];

const barsAlt = `أكبر ${series.length} سلاسل بالساعات المفرَّغة: ${series.map((item) => `${item.name} ${item.hours} ساعة`).join("، ")}.`;
const cumAlt = `الساعات المفرَّغة تراكميًا من ${cumulative[0]?.label} إلى ${cumulative.at(-1)?.label}، وصولًا إلى ${cumulative.at(-1)?.hours} ساعة.`;

if (cumulative.at(-1)?.hours !== 2300 || series.length !== 8) {
  throw new Error("Platform statistics are incomplete");
}
---

<section class="mt-14 border-border border-t pt-10" id="platform-content">
  <h2 class="font-semibold text-lg tracking-tight">محتوى المنصة</h2>
  <p class="mt-2 text-muted text-sm">ما هو متاح في الكشّاف حتى الآن</p>

  <ul class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3">
    {cards.map((card) => (
        <li class="card flex items-center gap-3 p-4">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent"
          >
            <svg
              aria-hidden="true"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              viewBox="0 0 24 24"
            >
              {card.icon.map((path) => <path d={path} />)}
            </svg>
          </span>
          <div class="min-w-0">
            <span class="block text-muted text-sm">{card.label}</span>
            <span
              class:list={[
                "mt-0.5 block font-semibold text-lg md:text-xl",
                !card.date && "digits",
              ]}>{card.value}</span
            >
          </div>
        </li>
      ))}
  </ul>

  <div class="mt-3 grid gap-3 md:grid-cols-2" id="platform-charts">
    <section class="card p-4">
      <h3 class="font-semibold text-base">أكبر السلاسل تفريغًا</h3>
      <p class="mt-1 text-muted text-sm">
        أطول {series.length} سلاسل بالساعات المفرَّغة من أصل 292
      </p>
      <div class="relative mt-4 h-56">
        <canvas aria-label={barsAlt} id="chart-series" role="img"></canvas>
      </div>
    </section>

    <section class="card p-4">
      <h3 class="font-semibold text-base">الساعات المفرَّغة تراكميًا</h3>
      <p class="mt-1 text-muted text-sm">مجموع الساعات المفرَّغة سنةً بعد سنة</p>
      <div class="relative mt-4 h-56">
        <canvas aria-label={cumAlt} id="chart-cumulative" role="img"></canvas>
      </div>
    </section>
  </div>
</section>

<script>
  import type { TooltipItem } from "chart.js";
  import { cumulative, series } from "../lib/platform-stats";

  const truncate = (name: string) =>
    name.length > 20 ? `${name.slice(0, 19).trimEnd()}…` : name;

  // Chart.js re-runs scriptable options on every update, so colours are
  // functions reading the palette captured at the last theme flip.
  const readTheme = () => {
    const style = getComputedStyle(document.documentElement);
    const token = (name: string) => style.getPropertyValue(name).trim();
    return {
      accent: token("--accent"),
      border: token("--border"),
      fg: token("--fg"),
      muted: token("--muted"),
      surface: token("--surface"),
    };
  };
  let theme = readTheme();

  const load = async () => {
    const {
      BarController,
      BarElement,
      CategoryScale,
      Chart,
      Filler,
      LinearScale,
      LineController,
      LineElement,
      PointElement,
      Tooltip,
    } = await import("chart.js");
    Chart.register(
      BarController,
      BarElement,
      CategoryScale,
      Filler,
      LinearScale,
      LineController,
      LineElement,
      PointElement,
      Tooltip
    );
    Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
    Chart.defaults.font.size = 12;
    Chart.defaults.locale = "en-US";
    Chart.defaults.animation = matchMedia("(prefers-reduced-motion: reduce)")
      .matches
      ? false
      : { duration: 400 };
    // Scriptable colours cannot be interpolated; animating them breaks rendering.
    Chart.defaults.animations.colors = false;

    const tooltip = {
      backgroundColor: () => theme.surface,
      bodyColor: () => theme.fg,
      borderColor: () => theme.border,
      borderWidth: 1,
      displayColors: false,
      padding: 10,
      rtl: true,
      textDirection: "rtl",
      titleColor: () => theme.fg,
    };
    // U+200F keeps the number on the right of the unit inside the RTL tooltip.
    const hoursLabel = (value: number | null) =>
      `\u200f${(value ?? 0).toLocaleString("en-US")} ساعة`;
    const ticks = (extra = {}) => ({
      color: () => theme.muted,
      maxTicksLimit: 5,
      ...extra,
    });
    const grid = { color: () => theme.border };
    // Axis borders are not scriptable in the types; a getter stays live across updates.
    const border = {
      get color() {
        return theme.border;
      },
    };

    const seriesChart = new Chart("chart-series", {
      data: {
        datasets: [
          {
            backgroundColor: () => theme.accent,
            borderRadius: 4,
            borderWidth: 0,
            data: series.map((item) => item.hours),
          },
        ],
        labels: series.map((item) => truncate(item.name)),
      },
      options: {
        indexAxis: "y",
        interaction: { axis: "y", intersect: false, mode: "index" },
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            ...tooltip,
            callbacks: {
              label: (item: TooltipItem<"bar">) => hoursLabel(item.parsed.x),
              // The axis label is truncated; the tooltip shows the full name.
              title: (items: TooltipItem<"bar">[]) =>
                series[items[0]?.dataIndex ?? 0]?.name ?? "",
            },
          },
        },
        responsive: true,
        scales: {
          x: {
            beginAtZero: true,
            border,
            grid,
            reverse: true,
            ticks: ticks({ precision: 0 }),
          },
          y: {
            border,
            grid: { display: false },
            position: "right",
            ticks: ticks({ autoSkip: false, maxTicksLimit: series.length }),
          },
        },
      },
      type: "bar",
    });

    const cumulativeChart = new Chart("chart-cumulative", {
      data: {
        datasets: [
          {
            backgroundColor: () => `${theme.accent}22`,
            borderColor: () => theme.accent,
            borderWidth: 2,
            data: cumulative.map((point) => point.hours),
            fill: true,
            pointBackgroundColor: () => theme.accent,
            pointHoverRadius: 4,
            pointRadius: 0,
            tension: 0.25,
          },
        ],
        labels: cumulative.map((point) => point.label),
      },
      options: {
        interaction: { intersect: false, mode: "index" },
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            ...tooltip,
            callbacks: {
              label: (item: TooltipItem<"line">) => hoursLabel(item.parsed.y),
            },
          },
        },
        responsive: true,
        scales: {
          x: {
            border,
            grid: { display: false },
            reverse: true,
            ticks: ticks({ maxRotation: 0 }),
          },
          y: {
            beginAtZero: true,
            border,
            grid,
            position: "right",
            ticks: ticks(),
          },
        },
      },
      type: "line",
    });

    new MutationObserver(() => {
      theme = readTheme();
      for (const chart of [seriesChart, cumulativeChart]) {
        chart.update("none");
      }
    }).observe(document.documentElement, {
      attributeFilter: ["class"],
      attributes: true,
    });
  };

  const root = document.getElementById("platform-charts");
  if (root) {
    // Chart.js only downloads once the section is approached.
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) {
          return;
        }
        observer.disconnect();
        load();
      },
      { rootMargin: "200px" }
    );
    observer.observe(root);
  }
</script>
