---
import { arabicDate } from "../lib/format";

const num = (value: number) => value.toLocaleString("en-US");

const cards = [
  {
    icon: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18", "m10.3 8.5 5.2 3.5-5.2 3.5Z"],
    label: "الدروس",
    value: num(4360),
  },
  {
    icon: ["M4 7h12M4 12h12M4 17h7", "m17 13 4 2.5-4 2.5Z"],
    label: "السلاسل",
    value: num(292),
  },
  {
    icon: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18", "M12 7.5V12l3 2"],
    label: "الساعات المفرَّغة",
    value: num(2300),
  },
  {
    date: true,
    icon: [
      "M20 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2Z",
      "M8 9h8M8 13h5",
    ],
    label: "مقاطع التفريغ",
    value: num(379_112),
  },
  {
    icon: [
      "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z",
      "M14 3v5h5",
      "M9 13h6M9 17h4",
    ],
    label: "المقالات",
    value: num(4455),
  },
  {
    icon: [
      "M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z",
      "M8 3v4M16 3v4M4 11h16",
    ],
    label: "آخر إضافة",
    value: arabicDate("2026-09-10"),
  },
];

const series = [
  { hours: 126, name: "الدارمي" },
  { hours: 111.5, name: "المغني" },
  { hours: 59.5, name: "مراجعات ومناصحات" },
  { hours: 51.9, name: "تاريخ الإسلام" },
  { hours: 48.1, name: "سيرة ابن هشام" },
  { hours: 47.1, name: "السنة لأبي بكر الخلال" },
  { hours: 44.1, name: "السنة" },
  { hours: 43.5, name: "الجامع" },
];

const cumulative = [
  { hours: 427, label: "2017" },
  { hours: 586, label: "2018" },
  { hours: 723, label: "2019" },
  { hours: 871, label: "2020" },
  { hours: 1039, label: "2021" },
  { hours: 1199, label: "2022" },
  { hours: 1338, label: "2023" },
  { hours: 1526, label: "2024" },
  { hours: 1917, label: "2025" },
  { hours: 2300, label: "2026" },
];

const maxSeriesHours = Math.max(...series.map(({ hours }) => hours));
// Time flows right to left: 2017 sits at the start (right) edge in RTL.
const left = 16;
const right = 456;
const top = 20;
const bottom = 320;
const maxHours = 2500;
const yOf = (hours: number) => bottom - (hours / maxHours) * (bottom - top);
const points = cumulative.map(({ hours }, index) => ({
  x: right - (index * (right - left)) / (cumulative.length - 1),
  y: yOf(hours),
}));
const line = points
  .map(({ x, y }, index) => `${index ? "L" : "M"}${x},${y}`)
  .join(" ");
const area = `${line} L${left},${bottom} L${right},${bottom} Z`;
const last = points.at(-1) ?? { x: left, y: top };

if (cumulative.at(-1)?.hours !== 2300 || series.length !== 8) {
  throw new Error("Platform statistics are incomplete");
}
---

<section class="mt-14 border-border border-t pt-10" id="platform-content">
  <h2 class="font-semibold text-lg tracking-tight">محتوى المنصة</h2>
  <p class="mt-2 text-muted text-sm">ما هو متاح في الكشّاف حتى الآن</p>

  <ul class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3">
    {cards.map((card) => (
        <li class="card flex items-center gap-3 p-4">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent"
          >
            <svg
              aria-hidden="true"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              viewBox="0 0 24 24"
            >
              {card.icon.map((path) => <path d={path} />)}
            </svg>
          </span>
          <div class="min-w-0">
            <span class="block text-muted text-sm">{card.label}</span>
            <span
              class:list={[
                "mt-0.5 block font-semibold text-lg md:text-xl",
                !card.date && "digits",
              ]}>{card.value}</span
            >
          </div>
        </li>
      ))}
  </ul>

  <div class="mt-3 grid gap-3 md:grid-cols-2">
    <section class="card p-5">
      <h3 class="font-semibold text-base">أكبر السلاسل تفريغًا</h3>
      <p class="mt-1 text-muted text-sm">أطول 8 سلاسل من أصل 292</p>
      <ol aria-label="أكبر السلاسل حسب الساعات المفرغة" class="mt-5 space-y-3">
        {series.map((item) => (
            <li class="grid grid-cols-[7.5rem_minmax(0,1fr)_3rem] items-center gap-3 text-sm">
              <span class="truncate" title={item.name}>{item.name}</span>
              <div class="h-2.5 overflow-hidden rounded-full bg-surface-2">
                <div
                  class="h-full rounded-full bg-accent"
                  style={`width: ${(item.hours / maxSeriesHours) * 100}%`}
                />
              </div>
              <span class="digits text-end text-muted">
                {item.hours}
                <span class="sr-only">ساعة</span>
              </span>
            </li>
          ))}
      </ol>
    </section>

    <section class="card p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="font-semibold text-base">الساعات المفرَّغة تراكميًا</h3>
          <p class="mt-1 text-muted text-sm">مجموع ساعات المحتوى سنةً بعد سنة</p>
        </div>
        <span class="digits shrink-0 font-semibold text-accent text-xl">
          {num(2300)}
        </span>
      </div>
      <svg
        aria-labelledby="cumulative-title cumulative-description"
        class="mt-4 h-auto w-full"
        direction="ltr"
        role="img"
        viewBox="0 0 520 350"
      >
        <title id="cumulative-title">الساعات المفرغة تراكميًا</title>
        <desc id="cumulative-description">
          ارتفعت الساعات من 427 ساعة في 2017 إلى 2300 ساعة في 2026.
        </desc>
        {[0, 1000, 2000].map((value) => (
          <g>
            <line
              class="stroke-border"
              stroke-dasharray={value ? "4 4" : undefined}
              x1={left}
              x2={right}
              y1={yOf(value)}
              y2={yOf(value)}
            />
            <text
              class="fill-muted text-[13px]"
              text-anchor="end"
              x="516"
              y={yOf(value) + 4}
            >
              {num(value)}
            </text>
          </g>
        ))}
        <path class="fill-accent/15" d={area}></path>
        <path
          class="fill-none stroke-accent"
          d={line}
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="3"
        ></path>
        <circle
          class="fill-accent stroke-(--surface)"
          cx={last.x}
          cy={last.y}
          r="5"
          stroke-width="2.5"
        ></circle>
        {cumulative.map((point, index) => {
          const coordinates = points[index];
          return index % 3 === 0 ? (
            <text
              class="fill-muted text-[13px]"
              text-anchor="middle"
              x={coordinates.x}
              y="344"
            >
              {point.label}
            </text>
          ) : null;
        })}
      </svg>
    </section>
  </div>
</section>
