{
  "name": "kashaf-alkulify",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check && biome check",
    "dev": "astro dev",
    "format": "biome check --write",
    "lint": "biome check",
    "prepare": "lefthook install",
    "preview": "astro preview",
    "search:check": ".search-venv/bin/python -m unittest discover -s scripts/search -p 'test_*.py'",
    "search:embed": ".search-venv/bin/python scripts/search/cli.py embed",
    "search:eval": ".search-venv/bin/python scripts/search/cli.py eval",
    "search:export": ".search-venv/bin/python scripts/search/cli.py export",
    "search:index": ".search-venv/bin/python scripts/search/cli.py index",
    "search:prepare": ".search-venv/bin/python scripts/search/cli.py prepare",
    "search:serve": ".search-venv/bin/python scripts/search/cli.py serve",
    "search:verify": ".search-venv/bin/python scripts/search/cli.py verify"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@base-ui/react": "^1.8.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vidstack/react": "^1.15.6",
    "astro": "^7.3.2",
    "aws4fetch": "^1.0.20",
    "better-auth": "~1.6.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "convex": "^1.45.0",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.13",
    "lefthook": "^2.1.12",
    "typescript": "^6.0.3",
    "ultracite": "^7.11.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook@2.1.12": true
  }
