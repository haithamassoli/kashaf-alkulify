{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/astro"],
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "overrides": [
    {
      // Vendored agent-skill assets and Convex codegen: not hand-written source.
      // Linting them means `format` rewrites files their generators own, and the
      // next `convex dev` or skill install undoes it.
      "includes": [".agents/**", ".claude/**", "**/_generated/**"],
      "linter": { "enabled": false },
      "assist": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // Astro components/layouts are PascalCase by convention.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": { "filenameCases": ["PascalCase", "kebab-case"] }
            }
          }
        }
      }
    },
    {
      // The archive pipeline's mutations and queries, and the dashboard's
      // read side. A Convex mutation is one
      // transaction, so its writes are sequential on purpose — order is the
      // invariant (lookup-then-write, offsets recomputed in part order), and
      // Promise.all would trade that for nothing. The rule is right about
      // network I/O and wrong about a transaction body.
      "includes": [
        "convex/admin.ts",
        "convex/mutations.ts",
        "convex/queries.ts"
      ],
      //
      // noEvolvingTypes is off for the same files: the accumulators there
      // collect inline projections, and TypeScript's evolving-array inference
      // already types them correctly. Satisfying the rule would mean writing
      // each projection's shape out twice.
      "linter": {
        "rules": {
          "performance": { "noAwaitInLoops": "off" },
          "suspicious": { "noEvolvingTypes": "off" }
        }
      }
    },
    {
      // Standalone asset files, not inline JSX.
      "includes": ["**/*.svg"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    }
  ]
}
